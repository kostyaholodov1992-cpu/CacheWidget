<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"> <!-- Чуть меньше нижний отступ -->

    <!-- Переключатель Тёмная -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sw_dark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Тёмная"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Переключатель Светлая -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sw_light"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Светлая"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sw_dark" />

    <!-- Переключатель Автоматическая -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sw_auto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Автоматическая"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sw_light" />

    <!-- Кнопка Готово (по центру по вертикали и горизонтали) -->
    <Button
        android:id="@+id/btn_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Готово"
        android:textColor="@color/text_primary"
        style="@style/Widget.Material3.Button.TextButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sw_auto"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
