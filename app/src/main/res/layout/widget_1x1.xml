<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg_rounded"
    android:padding="8dp">

    <!-- Крупная иконка, занимает место пропорционально -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧹"
        android:textSize="24sp"
        android:layout_marginBottom="4dp"/>

    <!-- Кнопка на всю ширину, но не гигантская -->
    <Button
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:text="Очистить кэш"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/widget_btn"
        android:paddingVertical="4dp"/>
</LinearLayout>
